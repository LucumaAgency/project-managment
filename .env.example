# Copiar a .env. En producción el panel (CloudPanel) define estas variables y gana sobre el archivo.

# La API se conecta con el rol SIN privilegios: Row Level Security aplica a todas sus consultas.
DATABASE_URL="postgresql://pm_app:pm_app_dev@localhost:5433/lucuma_pm"
# Migraciones, worker y superadmin: rol dueño de las tablas, con BYPASSRLS. Nunca para peticiones.
DATABASE_ADMIN_URL="postgresql://pm_admin:pm_admin_dev@localhost:5433/lucuma_pm"

PORT=3100
APP_URL="http://localhost:5174"
# Dominio base: cada cuenta vive en <slug>.BASE_DOMAIN. Vacío en local = cuenta por ?cuenta=slug.
BASE_DOMAIN=""
SESSION_SECRET="dev-no-usar-en-produccion"
