# Copiar a .env. En producción el panel (CloudPanel) define estas variables y gana sobre el archivo.

# La API se conecta con el rol SIN privilegios: Row Level Security aplica a todas sus consultas.
DATABASE_URL="postgresql://pm_app:pm_app_dev@localhost:5433/lucuma_pm"
# Migraciones, worker y consola: rol DUEÑO de las tablas (por eso ve todo, D-44). Nunca para peticiones.
DATABASE_ADMIN_URL="postgresql://pm_admin:pm_admin_dev@localhost:5433/lucuma_pm"

PORT=3100
APP_URL="http://localhost:5174"
# Dominio base: cada cuenta vive en <slug>.BASE_DOMAIN. Vacío en local = cuenta por ?cuenta=slug.
BASE_DOMAIN=""
SESSION_SECRET="dev-no-usar-en-produccion"

# Beta: el soporte de Lucuma (users.isStaff, se marca con `npm run usuario -- soporte <correo>`)
# entra a cualquier cuenta como administrador, y queda registrado. Poner 0 al salir de la beta.
SOPORTE_BETA=1

# Correo saliente (Brevo por SMTP). En el MVP NO hay correo: sin SMTP_HOST la web oculta el
# acceso por enlace y las invitaciones se comparten a mano.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Lucuma Proyectos <no-reply@dominio-de-la-app>"

# Latido externo (recordatorios de tareas, día 12): un servicio como cron-job.org llama cada
# hora a https://<dominio>/api/v1/cron/latido con el encabezado X-PM-Cron: <este valor>.
# Sin CRON_TOKEN el latido responde 503 (los recordatorios igual se calculan al usar la app).
# CRON_TOKEN=""

# Errores a Sentry (D-59). Vacío = no se manda nada. Un proyecto "Node" para la API y otro
# "Browser JavaScript" para la web (opcional). El DSN se copia de Sentry → Settings → Client Keys.
# SENTRY_DSN=""
# SENTRY_DSN_WEB=""

# Accesos protegidos (D-66): clave para cifrar contraseñas de dominio, hosting, etc. 64
# caracteres hex. `base:verificar:prod` sugiere una si falta. Si se pierde o se cambia, los
# accesos guardados ya no se pueden leer: guárdala también fuera del servidor.
# ACCESOS_CLAVE=""

# Respaldo diario de la base (D-60): pg_dump a privados/respaldos, se guardan 14.
# PG_BIN_DIR solo si pg_dump no está en el PATH (p. ej. /usr/lib/postgresql/12/bin).
# RESPALDOS_MANTENER=14
# PG_BIN_DIR=""
