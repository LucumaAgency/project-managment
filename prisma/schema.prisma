// Lucuma Proyectos — esquema del MVP (tipo Basecamp, multi-cuenta, listo para vender)
//
// Motor: PostgreSQL 16. Se eligió sobre MariaDB (la del CRM) por dos cosas que MariaDB no tiene:
//   1. Row Level Security: la BASE bloquea que una cuenta lea filas de otra, aunque el código
//      olvide un filtro. Políticas en la migración `rls_busqueda`.
//   2. Búsqueda full-text con índice GIN, sin servicio aparte.
//
// Tres ideas que sostienen todo el modelo:
//   - Account = la agencia que paga. Toda tabla con datos de clientes lleva accountId.
//   - User es GLOBAL (un correo = una persona) y entra a cuentas por Membership. Así un cliente
//     puede trabajar con dos agencias, y soporte puede entrar a una cuenta sin otra identidad.
//   - Recording = todo lo que vive dentro de un proyecto (lista, tarea, mensaje, carpeta,
//     archivo, comentario). Comentarios, menciones, papelera, actividad, suscripciones y
//     visibilidad para clientes se programan UNA vez, sobre Recording.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// La API: rol pm_app, sujeto a RLS.
  url       = env("DATABASE_URL")
  /// Migraciones (prisma migrate): rol pm_admin, dueño de las tablas.
  directUrl = env("DATABASE_ADMIN_URL")
}

// ------------------------------------------------------------------ cuentas y personas

model Account {
  id        String   @id @default(cuid())
  name      String
  /// Subdominio: <slug>.app.com (mismo esquema que el CRM, CRM_BASE_DOMAIN).
  slug      String   @unique
  /// Plan comercial. En el MVP todas son `interno`; los límites salen de shared/planes.ts.
  plan      String   @default("interno")
  /// Excepciones al plan para esta cuenta: { maxUsers?, maxProjects?, maxStorageBytes? }.
  limits    Json?
  /// Zona horaria por defecto para resúmenes y recordatorios si el usuario no definió la suya.
  timeZone  String   @default("America/Lima")
  locale    String   @default("es")
  settings  Json?
  createdAt DateTime @default(now())
  /// Cierre de cuenta: se marca y un job borra todo a los 30 días (exportación disponible antes).
  closedAt  DateTime?

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]
  members     ProjectMember[]
  recordings  Recording[]
  blobs       Blob[]
  events      Event[]
  notifications Notification[]
  auditLog    AuditLog[]

  @@map("accounts")
}

/// Persona. Global: no pertenece a ninguna cuenta (eso es Membership). Sin RLS.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  /// scrypt `scrypt$N$r$p$sal$hash`, igual que el CRM (lib/password.ts). Null = solo enlace mágico.
  passwordHash      String?
  passwordChangedAt DateTime?
  /// Null = usa el de la cuenta.
  timeZone          String?
  locale            String?
  avatarBlobKey     String?
  /// Soporte de Lucuma: puede entrar a cualquier cuenta (siempre queda en AuditLog).
  isStaff           Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())

  memberships   Membership[]
  loginTokens   LoginToken[]
  sessions      Session[]
  projectRoles  ProjectMember[]
  recordings    Recording[]     @relation("RecordingCreator")
  trashed       Recording[]     @relation("RecordingTrasher")
  assignedTodos TodoAssignee[]
  completed     TodoDetail[]
  uploads       UploadVersion[]
  mentions      Mention[]
  subscriptions Subscription[]
  events        Event[]
  notifications Notification[]

  @@map("users")
}

enum AccountRole {
  owner  // dueño: facturación, cerrar cuenta, todo lo de admin
  admin  // gestiona personas y todos los proyectos
  member // equipo: ve y trabaja en los proyectos donde está
  client // invitado externo: solo ve lo marcado como visible para clientes
}

enum MembershipStatus {
  active
  disabled
}

model Membership {
  id        String           @id @default(cuid())
  accountId String
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AccountRole      @default(member)
  status    MembershipStatus @default(active)
  /// Empresa del cliente (se muestra junto a su nombre: "María · Proba").
  company   String?
  /// Preferencias de aviso en ESTA cuenta: { email: "inmediato" | "resumen" | "nunca" }.
  prefs     Json?
  createdAt DateTime         @default(now())

  @@unique([accountId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String      @id @default(cuid())
  accountId   String
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email       String
  role        AccountRole @default(member)
  /// Opcional: al aceptar, entra directo a este proyecto (caso típico del cliente).
  projectId   String?
  tokenHash   String      @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([accountId, email])
  @@map("invitations")
}

/// Enlace mágico de acceso (mismo flujo que el CRM).
model LoginToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("login_tokens")
}

/// Sesión del navegador. La cookie guarda el token; aquí solo su hash.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ------------------------------------------------------------------------- proyectos

enum ProjectStatus {
  active
  archived
  trashed
}

model Project {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(active)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?
  trashedAt   DateTime?

  members    ProjectMember[]
  recordings Recording[]
  events     Event[]

  @@index([accountId, status])
  @@map("projects")
}

/// Quién está en cada proyecto. Owner/admin ven todos los proyectos sin estar aquí.
model ProjectMember {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([accountId, userId])
  @@map("project_members")
}

// ------------------------------------------------------------- recordings (el núcleo)

enum RecordingType {
  todolist // lista de tareas
  todo     // tarea (parent = todolist)
  message  // anuncio / tema del proyecto
  folder   // carpeta de archivos (parent = otra carpeta o null = raíz)
  upload   // archivo con versiones (parent = folder o null)
  comment  // comentario (parent = cualquier otro recording)
}

enum RecordingStatus {
  active
  archived
  trashed
}

/// Todo lo que vive en un proyecto. Los campos comunes están aquí; lo propio de cada tipo
/// va en una tabla de detalle 1 a 1 (TodoDetail, UploadVersion).
///
/// Reglas de visibilidad (en services/visibilidad.ts, no en las rutas):
///   - Un hijo nunca es más visible que su padre.
///   - Lo que crea un cliente nace visible para clientes.
///   - Un comentario hereda la visibilidad de lo que comenta.
model Recording {
  id               String          @id @default(cuid())
  accountId        String
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             RecordingType
  parentId         String?
  parent           Recording?      @relation("RecordingTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         Recording[]     @relation("RecordingTree")
  creatorId        String
  creator          User            @relation("RecordingCreator", fields: [creatorId], references: [id])
  title            String?
  /// Documento de Tiptap (JSON). Es la fuente; lo demás se deriva al guardar.
  body             Json?
  /// HTML sanitizado en el servidor, listo para mostrar y para correos.
  bodyHtml         String?
  /// Texto plano para búsqueda, previews de notificación y resumen diario.
  bodyText         String?
  visibleToClients Boolean         @default(false)
  status           RecordingStatus @default(active)
  /// Orden dentro del padre (listas, tareas, carpetas). Float para insertar entre dos sin
  /// renumerar: (a + b) / 2.
  position         Float           @default(0)
  trashedAt        DateTime?
  trashedById      String?
  trashedBy        User?           @relation("RecordingTrasher", fields: [trashedById], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  /// tsvector de title + bodyText, lo llena un trigger (migración `busqueda_por_trigger`).
  /// No escribirlo desde el código.
  search           Unsupported("tsvector")?

  todo          TodoDetail?
  assignees     TodoAssignee[]
  versions      UploadVersion[]
  attachments   RecordingAttachment[]
  mentions      Mention[]
  subscriptions Subscription[]
  events        Event[]
  notifications Notification[]

  @@index([projectId, type, status])
  @@index([parentId, position])
  @@index([accountId, status, trashedAt])
  @@index([search], type: Gin)
  @@map("recordings")
}

model TodoDetail {
  recordingId   String    @id
  recording     Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  /// Fecha sin hora: "para el viernes" no depende de zonas horarias.
  dueOn         DateTime? @db.Date
  startsOn      DateTime? @db.Date
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation(fields: [completedById], references: [id])

  @@index([dueOn])
  @@map("todo_details")
}

model TodoAssignee {
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  createdAt   DateTime  @default(now())

  @@id([recordingId, userId])
  @@index([accountId, userId])
  @@map("todo_assignees")
}

// ------------------------------------------------------------------------- archivos

enum BlobStatus {
  pending // URL firmada entregada, aún sin confirmar la subida
  ready
  failed
}

/// Un archivo físico en R2. Lo usan las versiones de un upload y los adjuntos del editor.
/// La suma de byteSize por cuenta es el almacenamiento que cuenta contra el plan.
model Blob {
  id          String     @id @default(cuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Clave en R2: <accountId>/<yyyy>/<mm>/<cuid>. Nunca el nombre original (puede traer datos).
  storageKey  String     @unique
  filename    String
  contentType String
  byteSize    BigInt
  checksum    String?
  width       Int?
  height      Int?
  /// Miniatura generada por el job blob.preview (imágenes y primera página de PDF).
  previewKey  String?
  status      BlobStatus @default(pending)
  createdById String
  createdAt   DateTime   @default(now())

  versions    UploadVersion[]
  attachments RecordingAttachment[]

  @@index([accountId, status])
  @@map("blobs")
}

/// Historial de versiones de un upload. La vigente es la de mayor `version`.
model UploadVersion {
  id           String    @id @default(cuid())
  recordingId  String
  recording    Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  blobId       String
  blob         Blob      @relation(fields: [blobId], references: [id], onDelete: Restrict)
  version      Int
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  note         String?
  createdAt    DateTime  @default(now())

  @@unique([recordingId, version])
  @@map("upload_versions")
}

/// Imagen o archivo pegado dentro del texto de un mensaje, tarea o comentario.
model RecordingAttachment {
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  blobId      String
  blob        Blob      @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@id([recordingId, blobId])
  @@map("recording_attachments")
}

// --------------------------------------------------- menciones, suscripciones, avisos

/// @menciones extraídas del body al guardar (no se confía en lo que manda el navegador).
model Mention {
  recordingId     String
  recording       Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  createdAt       DateTime  @default(now())

  @@id([recordingId, userId])
  @@map("mentions")
}

/// Quién sigue un recording (y recibe aviso de sus comentarios). Se suscribe solo quien lo
/// crea, quien comenta, a quien asignan y a quien mencionan; se puede salir a mano.
model Subscription {
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  createdAt   DateTime  @default(now())

  @@id([recordingId, userId])
  @@index([accountId, userId])
  @@map("subscriptions")
}

/// Actividad del proyecto: el feed y el historial. Se escribe en la misma transacción que
/// el cambio. Las notificaciones se generan a partir de aquí, en un job.
model Event {
  id               String     @id @default(cuid())
  accountId        String
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordingId      String?
  recording        Recording? @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  actorId          String
  actor            User       @relation(fields: [actorId], references: [id])
  /// created | updated | completed | reopened | assigned | unassigned | commented |
  /// version_uploaded | moved | trashed | restored | archived | visibility_changed
  action           String
  /// Antes/después de lo que cambió: { from, to } o lo que la acción necesite.
  details          Json?
  /// Copia de la visibilidad al momento del evento: el feed del cliente filtra por aquí.
  visibleToClients Boolean    @default(false)
  createdAt        DateTime   @default(now())

  notifications Notification[]

  @@index([projectId, createdAt])
  @@index([accountId, createdAt])
  @@map("events")
}

enum NotificationReason {
  mentioned
  assigned
  subscribed // comentario o cambio en algo que sigues
  due_soon   // tarea tuya que vence mañana (job diario)
}

/// La bandeja ("Hey!"). Una fila por persona y evento.
model Notification {
  id          String             @id @default(cuid())
  accountId   String
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     String?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recordingId String?
  recording   Recording?         @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  reason      NotificationReason
  readAt      DateTime?
  /// Cuándo salió por correo (inmediato o dentro del resumen). Null = aún no.
  emailedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId, accountId, readAt])
  @@index([emailedAt, createdAt])
  @@map("notifications")
}

// --------------------------------------------------------------------- infraestructura

enum JobStatus {
  pending
  running
  done
  failed
}

/// Cola de trabajos en la base (mismo patrón que el CRM). El worker toma con
/// `FOR UPDATE SKIP LOCKED`, así varios workers no pisan el mismo job. Sin Redis.
model Job {
  id          String    @id @default(cuid())
  /// email.send | notify.fanout | digest.daily | due.reminders | blob.preview |
  /// trash.purge | account.export | account.purge
  type        String
  accountId   String?
  payload     Json
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  maxAttempts Int       @default(6)
  lastError   String?
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  createdAt   DateTime  @default(now())

  @@index([status, runAt])
  @@map("jobs")
}

/// Seguridad y administración (no es el feed): logins, cambios de rol, invitaciones,
/// exportaciones, entradas de soporte (isStaff).
model AuditLog {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("audit_log")
}
